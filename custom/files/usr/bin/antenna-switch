#!/bin/sh
# Управление антенным RF-переключателем C300-1 / Notion R281 (MT7621)
# Физ. GPIO9/11 (bank0) = base(512) + 9/11 = 521/523 (output)
# Детект-пины GPIO12/14 на этой плате не разведены/не работают - не используются.

GPIO_A=521   # физ. GPIO9  - control bit A
GPIO_B=523   # физ. GPIO11 - control bit B
STATE_FILE=/etc/antenna_mode

export_out() {
    p=$1
    [ -d /sys/class/gpio/gpio$p ] || echo $p > /sys/class/gpio/export
    # пишем "out" только если ещё не out, иначе sysfs сбрасывает value в 0
    cur=$(cat /sys/class/gpio/gpio$p/direction 2>/dev/null)
    [ "$cur" = "out" ] || echo out > /sys/class/gpio/gpio$p/direction
}

export_out $GPIO_A
export_out $GPIO_B

set_ab() {
    echo $1 > /sys/class/gpio/gpio$GPIO_A/value
    echo $2 > /sys/class/gpio/gpio$GPIO_B/value
}

case "$1" in
    internal)
        set_ab 1 0
        echo internal > "$STATE_FILE"
        ;;
    external)
        set_ab 0 1
        echo external > "$STATE_FILE"
        ;;
    status)
        echo "GPIO$GPIO_A(A)=$(cat /sys/class/gpio/gpio$GPIO_A/value) GPIO$GPIO_B(B)=$(cat /sys/class/gpio/gpio$GPIO_B/value)"
        echo "saved mode: $(cat "$STATE_FILE" 2>/dev/null || echo '(none, defaults to internal)')"
        ;;
    *)
        echo "usage: $0 internal|external|status"
        exit 1
        ;;
esac
